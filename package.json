    "gulp-cssnano": "^2.1.3",
    "gulp-htmlmin": "^5.0.1",
    "gulp-iconutil": "^1.2.1",
    "gulp-rename": "^2.0.0",
    "gulp-sass": "^5.1.0",
    "gulp-sourcemaps": "^2.6.5",
    "gulp-string-replace": "^1.1.2",
    "gulp-uglify-es": "^2.0.0",
    "pump": "^3.0.0",
    "reset-css": "^5.0.1",
    "sass": "^1.80.0"
  },
  "allowScripts": {
    "macos-alias@0.2.12": true,
    "ds-store@0.1.6": true,
    "fs-xattr@0.3.1": true
