{
  "name": "nextcloud-bookmark-manager",
  "version": "3.0.2-alpha",
  "productName": "Nextcloud Bookmark Manager",
  "description": "Access and manage your Nextcloud bookmarks on the Mac",
  "main": "dist/js/main.min.js",
  "scripts": {
    "start": "electron .",
    "package": "gulp build && electron-packager . --asar --overwrite --platform=darwin --arch=arm64 --icon=dist/assets/icon/icon.icns --ignore=\"app-source|gulpfile\\.js|README\\.md\" --prune --out=build --darwinDarkModeSupport=true",
    "dmg": "node scripts/dmg/make-dmg.js"
  },
  "author": {
    "name": "D.G. Midwinter",
    "email": "duncan@midwinter-dg.com",
    "url": "https://www.midwinter-dg.com"
  },
  "contributors": [
    {
      "name": "T. Bautista",
      "email": "tomas.bautista@gmail.com",
      "url": "https://github.com/aknari"
    }
  ],
  "homepage": "https://www.midwinter-dg.com/mac-apps/nextcloud-bookmark-manager.html",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dgmid/nextcloud-bookmark-manager"
  },
  "bugs": "https://github.com/dgmid/nextcloud-bookmark-manager/issues",
  "browserslist": [
    "last 1 Chrome versions"
  ],
  "dependencies": {
    "@electron/remote": "^2.1.0",
    "axios": "^1.19.0",
    "color": "^3.1.3",
    "compare-versions": "^3.6.0",
    "datatables.net": "^1.10.22",
    "datatables.net-keytable": "^2.5.3",
    "datatables.net-responsive": "^2.2.6",
    "datatables.net-select": "^1.3.4",
    "dateformat": "^3.0.3",
    "detect-browsers": "^5.0.5",
    "electron-log": "^4.3.0",
    "electron-store": "^6.0.1",
    "fs-extra": "^9.0.1",
    "i18next": "^19.8.3",
    "i18next-electron-language-detector": "0.0.10",
    "i18next-sync-fs-backend": "^0.1.0",
    "is-url": "^1.2.4",
    "jquery": "^3.5.1",
    "jquery-i18next": "1.2.1",
    "mousetrap": "^1.6.5",
    "select2": "^4.0.13",
    "string-to-color": "^2.2.2"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "appdmg": "^0.6.6",
    "electron": "^34.0.0",
